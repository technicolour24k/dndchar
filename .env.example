# Env is split across three files (see scripts/load-env.ts):
#   .env       - shared, no DATABASE_URL, committed defaults only
#   .env.local - local dev DB + seed user, gitignored
#   .env.prod  - the Neon prod DATABASE_URL + NODE_ENV=production, gitignored,
#                only ever loaded explicitly via `npm run db:migrate:prod`
#                or `npx tsx --env-file=.env.prod scripts/x.ts`
#
# This file documents the shared (.env) keys plus the shape of the other two.

PUBLIC_APP_NAME="D&D Character Manager"
PUBLIC_APP_URL=http://localhost:5173
NODE_ENV=development
SRD_API_BASE_URL=https://www.dnd5eapi.co/api/2014
SRD_IMPORT_ENDPOINTS=
SRD_IMPORT_DELAY_MS=200
SRD_IMPORT_MAX_RETRIES=6

# --- .env.local (local dev only) ---
# DATABASE_URL=postgresql://dndchar:dndchar@localhost:5432/dndchar_dev
#
# Used by npm run db:seed:user
# SEED_USER_EMAIL=
# SEED_USER_PASSWORD=
# SEED_USER_NAME=

# --- .env.prod (never load by default; prod only) ---
# DATABASE_URL=<Neon connection string>
# NODE_ENV=production
