# Env is split across three files (see scripts/load-env.ts):
#   .env       - shared, no DATABASE_URL, committed defaults only
#   .env.local - local dev DB + seed user, gitignored
#   .env.prod  - the Neon prod DATABASE_URL + NODE_ENV=production, gitignored,
#                only ever loaded explicitly via `npm run db:migrate:prod`
#                or `npx tsx --env-file=.env.prod scripts/x.ts`
#
# This file documents the shared (.env) keys plus the shape of the other two.

PUBLIC_APP_NAME="D&D Character Manager"
PUBLIC_APP_URL=http://localhost:5173
NODE_ENV=development
SRD_API_BASE_URL=https://www.dnd5eapi.co/api/2014
SRD_IMPORT_ENDPOINTS=
SRD_IMPORT_DELAY_MS=200
SRD_IMPORT_MAX_RETRIES=6

# db-traffic-reduction Phase 0: set to 1 to log per-request DB query/row/byte
# counts and a rolling "last 60s" summary (see src/lib/server/db/queryStats.ts).
# Off by default - no overhead unless set. Safe to enable temporarily on
# Railway after a deploy to confirm a traffic drop.
DB_QUERY_STATS=

# Where uploaded overworld map images are stored (absolute path). In production this is the Railway
# volume mounted at /data, so files survive deploys. Unset locally = ./data. If it is unset in
# production, uploads live inside the container and vanish on the next deploy.
# UPLOAD_DIR=/data/uploads

# In-VTT voice chat via Daily (daily.co). SERVER ONLY, never PUBLIC_. Put the real values in
# .env.local (dev) and on Railway (prod), never in this file. Voice is off if the key or domain is unset.
# DAILY_API_KEY=<key from the Daily dashboard, Developers page>
# DAILY_DOMAIN=<your Daily subdomain, e.g. mygroup for mygroup.daily.co>
# DAILY_ROOM_PREFIX=dev-            # dev- locally, prod- on Railway (up to 10 chars of A-Z a-z 0-9 _ -)
# Optional:
# DAILY_MAX_PARTICIPANTS=10         # 2 to 50
# DAILY_SESSION_CAP_HOURS=6         # 1 to 12, Daily ejects a participant after this long in one call

# --- .env.local (local dev only) ---
# DATABASE_URL=postgresql://dndchar:dndchar@localhost:5432/dndchar_dev
#
# Used by npm run db:seed:user
# SEED_USER_EMAIL=
# SEED_USER_PASSWORD=
# SEED_USER_NAME=

# --- .env.prod (never load by default; prod only) ---
# DATABASE_URL=<Neon connection string>
# NODE_ENV=production
